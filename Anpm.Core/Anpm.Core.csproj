<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Anpm.Core</RootNamespace>
    <AssemblyName>Anpm.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AnpmMcp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <GuidersPluginHostRoot Condition="'$(GuidersPluginHostRoot)' == ''">$(MSBuildThisFileDirectory)..\..\guiders-plugin-host</GuidersPluginHostRoot>
    <UseLocalGuidersPluginHost Condition="'$(UseLocalGuidersPluginHost)' == '' and Exists('$(GuidersPluginHostRoot)\AIGuiders.PluginHost.slnx')">true</UseLocalGuidersPluginHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalGuidersPluginHost)' == 'true'">
    <ProjectReference Include="$(GuidersPluginHostRoot)\src\AIGuiders.PluginHost.Runtime\AIGuiders.PluginHost.Runtime.csproj" />
  </ItemGroup>

</Project>
